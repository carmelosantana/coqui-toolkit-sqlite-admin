{
    "name": "coquibot/coqui-toolkit-sqlite-admin",
    "description": "SQLite database administration toolkit for Coqui — create, query, manage schemas, backup/restore, and vector search across multiple SQLite databases",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Carmelo Santana",
            "email": "git@carmelosantana.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "carmelosantana/php-agents": "^0.7",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoquiBot\\Toolkits\\SqliteAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoquiBot\\Toolkits\\SqliteAdmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "php-agents": {
            "toolkits": [
                "CoquiBot\\Toolkits\\SqliteAdmin\\SqliteAdminToolkit"
            ],
            "description": "Full SQLite database management — connect to multiple databases, execute queries, manage schemas, backup/restore, optimize, and vector search",
            "gated": {
                "sqlite_schema_modify": ["drop_table", "drop_index", "drop_view"],
                "sqlite_backup_restore": ["restore"],
                "sqlite_query": [{"write": true}]
            }
        }
    }
}
